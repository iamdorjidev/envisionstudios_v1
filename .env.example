# Copy to .env.local for local development, and set the same values in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Public site URL (used for canonical tags, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.envisionstudio.co.nz

# --- Enquiry form email delivery (Resend) ---
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiry notifications are delivered
ENQUIRY_TO_EMAIL=tdorji.dev@gmail.com

# Verified sender. Until a domain is verified in Resend you can use
# "enVision Studio <onboarding@resend.dev>" for testing.
ENQUIRY_FROM_EMAIL=enVision Studio <onboarding@resend.dev>
