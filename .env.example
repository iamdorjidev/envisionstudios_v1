# Copy to .env.local for local development, and set the same values in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Public site URL (used for canonical tags, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.envisionstudio.co.nz

# --- Enquiry form email delivery (Resend) ---
# Required. Create a key at https://resend.com/api-keys — without this,
# the enquiry form reports "not configured yet" instead of failing silently.
RESEND_API_KEY=

# Optional — both already default to the values below in code.
# Where enquiry notifications are delivered.
ENQUIRY_TO_EMAIL=thinley@envisionstudio.co.nz

# Verified sender. Until a domain is verified in Resend, the default
# "enVision Studio <onboarding@resend.dev>" works for testing.
ENQUIRY_FROM_EMAIL=enVision Studio <onboarding@resend.dev>
